# 이 파일을 복사해서 .env.local 로 저장한 뒤 값을 채우세요.
# (.env.local 은 .gitignore에 있어 커밋되지 않습니다)
#
# Supabase 값 위치: 대시보드 > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=발급받은_publishable_키

# 포스(/admin) 접속 비밀번호 — 서버 전용이라 브라우저에 노출되지 않습니다.
# 이 저장소는 공개이므로 기본값이 없습니다. 반드시 직접 정하세요.
# 설정하지 않으면 로그인 자체가 막힙니다.
# Vercel 배포 시에도 Settings > Environment Variables 에 같은 값을 등록하세요.
ADMIN_PASSWORD=
