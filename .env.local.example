# 이 파일을 복사해서 .env.local 로 저장한 뒤 값을 채우세요.
# 값 위치: Supabase 대시보드 > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=발급받은_publishable_키

# 관리자 페이지(/admin) 접속 비밀번호 (서버 전용 — 브라우저에 노출되지 않음)
# Vercel 배포 시에는 프로젝트 Settings > Environment Variables 에도 같은 값을 등록하세요.
ADMIN_PASSWORD=원하는비밀번호
